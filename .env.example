# Environment configuration for darun.dev
# Copy this file to .env and replace all values with your own.

# Server
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/your_db_name

# Redis
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=replace_with_a_random_string_of_at_least_32_characters
JWT_EXPIRES_IN=7d

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key

# Email (Resend)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM=noreply@yourdomain.com

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:5173
VITE_API_URL=

# Optional
# SENTRY_DSN=https://your_sentry_dsn
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=your_twilio_phone_number
# ADMIN_PHONE_NUMBER=your_admin_phone_number