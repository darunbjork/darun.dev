# Test-only environment — local services only, no real credentials.
# Loaded by packages/api/vitest.config.ts. Values already set in the shell or CI win.
# Start the services with: docker compose up -d postgres redis
# The test database is created by: pnpm --filter @darun/api exec prisma migrate deploy
NODE_ENV=test
PORT=3999
DATABASE_URL=postgresql://darundev:darundev@localhost:5434/darundev_test
REDIS_URL=redis://localhost:6380
JWT_SECRET=test-secret-32-chars-minimum-abc
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
ADMIN_EMAIL=admin@darun.dev
ADMIN_PASSWORD=TestPassword123!
GEMINI_API_KEY=test
RESEND_API_KEY=test
RESEND_FROM=noreply@darun.dev
CLOUDINARY_CLOUD_NAME=test
CLOUDINARY_API_KEY=test
CLOUDINARY_API_SECRET=test
CLOUDINARY_URL=cloudinary://test:test@test
# Blank/dummy so the real values in the root .env are never picked up
GITHUB_TOKEN=
ADZUNA_APP_ID=test
ADZUNA_APP_KEY=test
